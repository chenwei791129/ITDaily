{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "it-daily",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run the Worker (and count as Worker requests);
    // everything else is a free static asset request.
    "run_worker_first": ["/api/*", "/healthz"]
  },
  "routes": [{ "pattern": "itdaily.awei.one", "custom_domain": true }],
  "workers_dev": false
}
